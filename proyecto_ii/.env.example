# Configuración del Proyecto II
# Plantilla de variables de entorno para desarrollo y pruebas

# Entorno general
APP_ENV=development
LOG_LEVEL=INFO

# Rutas de datos y modelos
DATA_PATH=data/madrid.csv
GEO_CACHE_PATH=data/geo_cache.json
MODEL_PATH=models/house_pricing_model.joblib
METRICS_PATH=models/metrics.json

# Parámetros para Nominatim OpenStreetMap
NOMINATIM_USER_AGENT=dsia_madrid_real_estate_valuation_v1
NOMINATIM_RATE_LIMIT_DELAY=1.0
NOMINATIM_MOCK=false

# Token oficial de Hugging Face requerido por rúbrica
HF_TOKEN=

# Configuración del servicio LLM (elige una de las opciones comentando o descomentando)
#
# Opcion 1: Ollama en local en tu propio equipo
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_ID=gemma4e2b
# LLM_API_KEY=ollama
#
# Opcion 2: Servidor remoto accesible por red privada Tailscale
# LLM_BASE_URL=http://<ip-o-host-tailscale>:<puerto>/v1
# LLM_MODEL_ID=
# LLM_API_KEY=

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_ID=gemma4e2b
LLM_API_KEY=ollama

# Activar modo mock para pruebas locales y CI sin conexion a la red
LLM_MOCK=true
